# ============================================================
# RebondPro Formation — variables d'environnement (exemple)
# Copier en .env.local pour le dev. Ne jamais committer .env.local.
# En production : utiliser un secret manager (pas de fichier .env).
# ============================================================

# --- Base de données ---
# Option A — PostgreSQL local (docker compose up -d)
DATABASE_URL="postgresql://rebondpro:rebondpro@localhost:5432/rebondpro?schema=public"
# Option B — Supabase (prod recommandé)
# Récupérer dans Supabase > Settings > Database > Connection string (mode "URI")
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Pour les migrations Prisma (non-pooled) :
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# --- Auth.js ---
# Générer un secret : openssl rand -base64 32  (ou npx auth secret)
AUTH_SECRET="change-me-in-production"
# URL de base de l'app (utile pour les callbacks / liens email)
AUTH_URL="http://localhost:3000"

# --- Email (SMTP) ---
# Dev : Mailpit (localhost:1025). Prod : Resend via SMTP (smtp.resend.com:465, user "resend",
# password = clé API re_...). EMAIL_FROM doit utiliser un domaine VÉRIFIÉ sur resend.com/domains ;
# sinon Resend n'envoie qu'à l'adresse du compte et impose onboarding@resend.dev en expéditeur.
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT="1025"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="RebondPro Formation <no-reply@rebondpro.local>"

# --- IA (Anthropic Claude) ---
ANTHROPIC_API_KEY=""
AI_MODEL_COMPLEX="claude-opus-4-8"
AI_MODEL_FAST="claude-haiku-4-5"

# --- AG-UI (agent intégré / chatbot) ---
AG_UI_PROVIDER="anthropic"
AG_UI_MODEL="claude-haiku-4-5"
AG_UI_REQUIRE_APPROVAL="true"
AG_UI_ENABLE_DEBUG="false"
# OPENAI_API_KEY=""            # uniquement si AG_UI_PROVIDER=openai

# --- Connecteurs externes via Composio ---
# Active Google Calendar/Drive, Gmail brouillon, Outlook brouillon, OneDrive, SharePoint et Microsoft Calendar.
# Les emails sont limités à la création de brouillons : aucun outil d'envoi direct n'est exposé.
COMPOSIO_API_KEY=""
# Optionnel : surcharger les slugs d'outils Composio si votre workspace les nomme différemment.
COMPOSIO_TOOL_GOOGLE_CALENDAR_LIST_EVENTS=""
COMPOSIO_TOOL_GOOGLE_DRIVE_SEARCH_FILES=""
COMPOSIO_TOOL_GOOGLE_DRIVE_GET_FILE=""
COMPOSIO_TOOL_GMAIL_CREATE_DRAFT=""
COMPOSIO_TOOL_OUTLOOK_CREATE_DRAFT=""
COMPOSIO_TOOL_ONEDRIVE_SEARCH_FILES=""
COMPOSIO_TOOL_ONEDRIVE_GET_FILE=""
COMPOSIO_TOOL_SHAREPOINT_SEARCH_FILES=""
COMPOSIO_TOOL_SHAREPOINT_GET_FILE=""
COMPOSIO_TOOL_MICROSOFT_CALENDAR_LIST_EVENTS=""

# --- Stockage fichiers ---
# Dev : "local" (disque). Prod : "supabase".
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Supabase Storage (prod — driver="supabase")
SUPABASE_URL=""                     # ex: https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=""             # Service Role Key (Settings > API)
SUPABASE_STORAGE_BUCKET="documents" # créer ce bucket dans Supabase Storage

# --- Facturation Stripe (Lot 7) ---
# Sans ces clés, l'app reste utilisable en FREE ; l'upgrade en ligne est simplement désactivé.
STRIPE_SECRET_KEY=""            # sk_test_... ou sk_live_...
STRIPE_WEBHOOK_SECRET=""        # whsec_... (Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_PRICE_PRO=""             # price_... (plan Pro, abonnement mensuel)
STRIPE_PRICE_PREMIUM=""         # price_... (plan Premium)
PLATFORM_COMMISSION_PCT="10"    # % de commission plateforme sur les achats de formation
PLATFORM_BILAN_PRICE="120000"   # prix du bilan de compétences en centimes (1200 € — cf. site /tarifs)
CONTACT_EMAIL=""                # destinataire des demandes du site vitrine (défaut : 1er PLATFORM_ADMIN_EMAILS)

# --- Super-admin plateforme ---
# Emails (séparés par virgule) ayant accès à /admin (vue cross-tenant de tout l'écosystème).
PLATFORM_ADMIN_EMAILS=""

# --- Divers ---
NODE_ENV="development"
APP_PUBLIC_URL="http://localhost:3000"
