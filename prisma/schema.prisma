// ============================================================
// RebondPro Formation — schéma de données (multi-tenant)
// Réf : CAHIER_DES_CHARGES.md §5
// Règle P1 : chaque entité métier porte organizationId.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- ENUMS -----------------------------

enum Role {
  OWNER
  ADMIN
  ASSISTANT
  COMMERCIAL
  TRAINER
  LEARNER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum Modality {
  PRESENTIEL
  DISTANCIEL
  HYBRIDE
}

enum Level {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum FormationStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}

// Statut de modération d'un centre sur la marketplace publique.
enum MarketplaceStatus {
  PENDING   // en attente de validation par l'admin plateforme
  APPROVED  // validé : centre + formations publiées visibles publiquement
  REJECTED  // refusé : reste masqué
}

enum SessionStatus {
  BROUILLON
  OUVERTE
  COMPLETE
  TERMINEE
  ANNULEE
}

enum Slot {
  MATIN
  APRES_MIDI
  JOURNEE
  SOIR
}

enum ProspectStage {
  NOUVEAU
  CONTACTE
  DEVIS
  RELANCE
  GAGNE
  PERDU
}

enum ProspectType {
  PARTICULIER
  ENTREPRISE
  ORGANISME
}

enum ProspectSource {
  LINKEDIN
  SITE_WEB
  APPEL
  RECOMMANDATION
  SALON
  CAMPAGNE_EMAIL
  PAGE_PUBLIQUE
  AUTRE
}

enum EnrollmentStatus {
  PRE_INSCRIT
  INSCRIT
  CONFIRME
  PRESENT
  ABSENT
  TERMINE
}

enum AvailabilityType {
  DISPONIBLE
  INDISPONIBLE
  TENTATIVE
}

enum RoomType {
  SALLE
  VISIO
}

enum DocumentType {
  PROGRAMME_FORMATION
  PROGRAMME
  FICHE_FORMATION_PUBLIQUE
  OBJECTIFS_PEDAGOGIQUES
  PREREQUIS_POSITIONNEMENT
  DEROULE_PEDAGOGIQUE_MODULE
  GRILLE_FORMATION_COMPETENCES
  PLAN_INDIVIDUEL_FORMATION
  CONVENTION_FORMATION_ENTREPRISE
  CONTRAT_FORMATION_PARTICULIER
  DEVIS_FORMATION
  BON_DE_COMMANDE
  CGV_B2B
  CGV_B2C
  CONVOCATION_APPRENANT
  CONVOCATION_FORMATEUR
  REGLEMENT_INTERIEUR
  FEUILLE_EMARGEMENT
  PLANNING_SESSION
  PLANNING_FORMATEUR
  ORDRE_MISSION_FORMATEUR
  FICHE_INTERVENTION_FORMATEUR
  RELEVE_ASSIDUITE
  FICHE_INCIDENT_SESSION
  DEMANDE_MODIFICATION_PLANNING
  SYNTHESE_DISPONIBILITES_FORMATEURS
  FICHE_APPRENANT
  GRILLE_EVALUATION_INITIALE
  GRILLE_EVALUATION_CONTINUE
  COMPTE_RENDU_PROGRESSION
  PLAN_ACCOMPAGNEMENT_INDIVIDUALISE
  FICHE_ACCESSIBILITE_HANDICAP
  BILAN_FIN_PARCOURS
  PV_EVALUATION
  BILAN_PEDAGOGIQUE_SESSION
  RAPPORT_QUALITE_SESSION
  ATTESTATION_ASSIDUITE
  FICHE_RECLAMATION
  ACTION_CORRECTIVE
  REGISTRE_AMELIORATION_CONTINUE
  AVOIR
  RECU_PAIEMENT
  RELANCE_PAIEMENT
  RELEVE_FINANCEMENTS
  DOSSIER_OPCO_FINANCEUR
  JUSTIFICATIF_FINANCEUR
  TABLEAU_ANNUEL_QUALITE
  RAPPORT_ACTIVITE_CENTRE
  CONVENTION_CONTRAT_BILAN
  FEUILLE_ROUTE_BENEFICIAIRE
  BILAN_PHASE_PRELIMINAIRE
  BILAN_PHASE_INVESTIGATION
  BILAN_PHASE_CONCLUSION
  SYNTHESE_BILAN_COMPETENCES
  PLAN_ACTION_3_6_MOIS
  RESTITUTION_IKIGAI
  CARTOGRAPHIE_COMPETENCES
  AUTORISATION_PARTAGE_DOSSIER
  DOSSIER_NUMERIQUE_EXPORTABLE
  CONVENTION
  CONTRAT_FORMATION
  LIVRET_ACCUEIL
  TEST_POSITIONNEMENT
  CONVOCATION
  EMARGEMENT
  SUPPORT_COURS
  QUESTIONNAIRE_SUIVI
  ATTESTATION
  CERTIFICAT
  ATTESTATION_PRESENCE
  QUESTIONNAIRE_SATISFACTION
  ENQUETE_SATISFACTION_CHAUD
  ENQUETE_SATISFACTION_FROID
  SYNTHESE_SATISFACTION
  DIPLOME_TITRE
  DEVIS
  FACTURE
  BPF
}

enum DocumentStatus {
  A_GENERER
  GENERE
  ENVOYE
}

enum DocumentCompletionStatus {
  COMPLETE
  PARTIAL
  DRAFT
}

enum DocumentTemplateStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum ComplaintStatus {
  OUVERTE
  EN_COURS
  RESOLUE
}

enum ImprovementStatus {
  OUVERTE
  EN_COURS
  FERMEE
}

enum ObjectifPrincipal {
  PLANIFIER
  VENDRE
  DOCUMENTS
  APPRENANTS
  CENTRALISER
}

// --------------------------- TENANT & AUTH ---------------------------

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  siret       String?
  website     String?
  description String?
  logoUrl     String?
  // Vitrine marketplace + profil public
  tagline       String? // accroche courte mise en avant
  coverImageUrl String? // bannière de la fiche centre
  city          String? // ville (filtre marketplace)
  publicProfileEnabled Boolean @default(true)
  // Modération marketplace (validation par l'admin plateforme avant affichage public)
  marketplaceStatus          MarketplaceStatus @default(PENDING)
  marketplaceReviewedAt      DateTime?
  marketplaceReviewedBy      String?  // userId de l'admin ayant validé/refusé
  marketplaceRejectionReason String?
  publicEmail   String?
  publicPhone   String?
  socialLinks   Json?    // { linkedin, facebook, instagram, ... }
  specialties   String[] @default([])
  modalities    String[] @default([]) // PRESENTIEL, DISTANCIEL, HYBRIDE
  certifications String[] @default([]) // Qualiopi, labels...
  timezone    String  @default("Europe/Paris")
  currency    String  @default("EUR")

  // Coordonnées légales (documents)
  legalName       String?
  legalAddress    String?
  nda             String? // n° déclaration d'activité
  legalRep        String? // représentant

  // Abonnement
  plan         Plan      @default(FREE)
  billingStatus String?  @default("trial")
  trialEndsAt  DateTime?
  // Facturation Stripe
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?

  // Onboarding déclaratif
  nbFormationsDeclarees Int?
  nbFormateursDeclares  Int?
  nbSessionsMois        Int?
  objectifPrincipal     ObjectifPrincipal?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships       Membership[]
  formations        Formation[]
  formationModules  FormationModule[]
  trainers          Trainer[]
  rooms             Room[]
  sessions          Session[]
  prospects         Prospect[]
  learners          Learner[]
  enrollments       Enrollment[]
  documents         Document[]
  documentTemplates DocumentTemplate[]
  complaints        Complaint[]
  improvementActions ImprovementAction[]
  feedbacks         Feedback[]
  aiInteractions    AiInteraction[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  testimonials      Testimonial[]
  faqs              Faq[]
  changeRequests    ChangeRequest[]
  beneficiaries     Beneficiary[]
  transactions      Transaction[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  emailVerified DateTime?
  lastLoginAt   DateTime?
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  platformAdmin    Boolean  @default(false) // super-admin plateforme (vue cross-tenant)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  trainer     Trainer?
  ownedProspects Prospect[] @relation("ProspectOwner")
  createdDocumentTemplates DocumentTemplate[]
  aiInteractions AiInteraction[]
  auditLogs     AuditLog[]
  notifications Notification[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  beneficiary             Beneficiary?
  roadmap2OwnedNodes       Roadmap2Node[]           @relation("Roadmap2NodeOwner")
  roadmap2CreatedNodes     Roadmap2Node[]           @relation("Roadmap2NodeCreator")
  roadmap2UpdatedNodes     Roadmap2Node[]           @relation("Roadmap2NodeUpdater")
  roadmap2CreatedEdges     Roadmap2Edge[]           @relation("Roadmap2EdgeCreator")
  roadmap2Updates          Roadmap2Update[]         @relation("Roadmap2UpdateAuthor")
  roadmap2AuditLogs        Roadmap2AuditLog[]       @relation("Roadmap2AuditActor")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?
  acceptedAt     DateTime?
  invitedEmail   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --------------------------- CATALOGUE ---------------------------

model Formation {
  id              String          @id @default(cuid())
  organizationId  String
  title           String
  slug            String
  category        String?
  shortDescription String?
  longDescription  String?
  objectives      String?
  targetAudience  String?
  prerequisites   String?
  program         String?
  durationDays    Int?
  durationHours   Int?
  price           Int             @default(0) // centimes
  modality        Modality        @default(PRESENTIEL)
  level           Level           @default(DEBUTANT)
  color           String?         @default("#5850ec")
  coverImageUrl   String?         // visuel de couverture (marketplace)
  status          FormationStatus @default(BROUILLON)
  isPublic        Boolean         @default(false)
  publicSlug      String?         @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions         Session[]
  eligibleTrainers TrainerFormation[]
  modules          FormationModule[]
  documents        Document[]
  testimonials     Testimonial[]
  faqs             Faq[]
  prospects        Prospect[]
  interests        FormationInterest[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Trainer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique
  firstName      String
  lastName       String
  initials       String?
  email          String?
  phone          String?
  color          String?  @default("#5850ec")
  photoUrl       String?  // photo de profil publique
  specialities   String[] @default([])
  bio            String?
  yearsExperience Int?    // ancienneté (vitrine formateur)
  active         Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  availabilities TrainerAvailability[]
  sessions       Session[]
  formations     TrainerFormation[]
  moduleAssignments FormationModuleTrainer[]
  sessionModuleAssignments SessionModuleAssignment[]
  changeRequests ChangeRequest[]

  @@index([organizationId])
}

// Table de liaison M:N Formation <-> Trainer (formateurs éligibles)
model TrainerFormation {
  trainerId   String
  formationId String

  trainer   Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@id([trainerId, formationId])
  @@index([formationId])
}

// Module pédagogique d'une formation. Une formation peut être structurée en
// plusieurs modules, chacun couvert par un ou plusieurs formateurs.
model FormationModule {
  id              String   @id @default(cuid())
  organizationId  String
  formationId     String
  title           String
  description     String?
  durationDays    Int?
  durationHours   Int?
  position        Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formation    Formation    @relation(fields: [formationId], references: [id], onDelete: Cascade)
  trainers     FormationModuleTrainer[]
  sessionAssignments SessionModuleAssignment[]

  @@index([organizationId])
  @@index([formationId])
}

model FormationModuleTrainer {
  moduleId  String
  trainerId String

  module  FormationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  trainer Trainer         @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([moduleId, trainerId])
  @@index([trainerId])
}

model TrainerAvailability {
  id        String           @id @default(cuid())
  trainerId String
  date      DateTime
  slot      Slot
  type      AvailabilityType @default(DISPONIBLE)
  note      String?

  createdAt DateTime @default(now())

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, date])
}

// Demande de modification d'un formateur (dispo ou affectation) vers son centre
model ChangeRequest {
  id             String   @id @default(cuid())
  organizationId String
  trainerId      String
  sessionId      String?
  availabilityId String?
  requestType    String   // unavailable | partial | propose_date | conflict | other
  reason         String?
  proposedDate   DateTime?
  proposedSlot   Slot?
  proposedStart  String?
  proposedEnd    String?
  urgency        String   @default("normal") // low | normal | high
  status         String   @default("pending") // pending | accepted | rejected | cancelled | counter_proposed
  centerResponse String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trainer      Trainer      @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([trainerId])
}

// --------------------------- BÉNÉFICIAIRES (B2C bilan de compétences) ---------------------------

// Personne accompagnée en bilan de compétences par un centre/opérateur.
model Beneficiary {
  id             String   @id @default(cuid())
  organizationId String   // centre/opérateur accompagnateur
  userId         String?  @unique
  firstName      String
  lastName       String
  email          String?
  phone          String?
  objective      String?  // projet professionnel visé
  situation      String?  // situation actuelle
  status         String   @default("active") // active | completed | archived
  startedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps        BilanStep[]
  artifacts    BilanArtifact[]
  interests    FormationInterest[]

  @@index([organizationId])
}

// Étape du parcours de bilan (3 phases légales : préliminaire, investigation, conclusion).
model BilanStep {
  id            String    @id @default(cuid())
  beneficiaryId String
  phase         String    // preliminaire | investigation | conclusion
  title         String
  description   String?
  order         Int       @default(0)
  status        String    @default("todo") // todo | in_progress | done
  notes         String?
  completedAt   DateTime?

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  artifacts   BilanArtifact[]

  @@index([beneficiaryId])
}

// Donnée structurée du dossier numérique de bilan.
// Sert à agréger les apports admin, bénéficiaire, Socrate, import document ou voix
// sans perdre la compatibilité avec les notes historiques de BilanStep.
model BilanArtifact {
  id            String   @id @default(cuid())
  beneficiaryId String
  stepId        String?
  key           String
  kind          String
  title         String
  content       Json
  source        String   @default("admin") // admin | beneficiary | socrate | document | voice
  status        String   @default("draft") // draft | validated | shareable | archived
  shareable     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  step        BilanStep?  @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@unique([beneficiaryId, key])
  @@index([beneficiaryId])
  @@index([stepId])
  @@index([kind])
  @@index([status])
}

// Transaction financière de la plateforme (source de vérité du CA et des commissions).
model Transaction {
  id             String   @id @default(cuid())
  organizationId String   // centre concerné (vendeur de formation OU abonné)
  type           String   // FORMATION_PURCHASE | SUBSCRIPTION | BILAN
  amount         Int      // montant total payé (centimes)
  commission     Int      @default(0) // part plateforme (centimes)
  currency       String   @default("EUR")
  status         String   @default("paid") // paid | pending | refunded | failed
  stripeRef      String?  @unique // id session/invoice/payment_intent (idempotence)
  payerEmail     String?
  payerName      String?
  formationId    String?
  beneficiaryId  String?
  enrollmentId   String?  // inscription créée par l'achat (FORMATION_PURCHASE → Enrollment)
  description    String?
  // Reversement au centre vendeur (modèle « tout encaisser + reverser ») :
  // pending = net dû au centre ; settled = reversé ; not_applicable = revenu propre plateforme (abo/bilan).
  payoutStatus   String   @default("pending")
  settledAt      DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@index([payoutStatus])
}

// Formation du catalogue marketplace sauvegardée ou demandée par un bénéficiaire.
model FormationInterest {
  id            String   @id @default(cuid())
  beneficiaryId String
  formationId   String
  status        String   @default("saved") // saved | requested
  createdAt     DateTime @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  formation   Formation   @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([beneficiaryId, formationId])
  @@index([beneficiaryId])
}

model Room {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           RoomType @default(SALLE)
  capacity       Int?
  location       String?
  url            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@index([organizationId])
}

// --------------------------- SESSIONS ---------------------------

model Session {
  id              String        @id @default(cuid())
  organizationId  String
  formationId     String
  trainerId       String?
  roomId          String?
  startDate       DateTime
  endDate         DateTime
  slots           Slot[]        @default([])
  capacity        Int           @default(10)
  pricePerLearner Int           @default(0) // centimes
  breakEvenSeats  Int           @default(1)
  status          SessionStatus @default(BROUILLON)
  trainerConfirmed Boolean      @default(false)
  notes           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formation    Formation    @relation(fields: [formationId], references: [id], onDelete: Cascade)
  trainer      Trainer?     @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  documents    Document[]
  moduleAssignments SessionModuleAssignment[]

  @@index([organizationId])
  @@index([formationId])
  @@index([trainerId])
}

// Affectation d'un formateur à un module pour UNE session précise.
// Mémorise « pour cette session : module A → formateur X, module B → formateur Y ».
model SessionModuleAssignment {
  id             String  @id @default(cuid())
  organizationId String
  sessionId      String
  moduleId       String
  trainerId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  module  FormationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  trainer Trainer?        @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@unique([sessionId, moduleId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([moduleId])
  @@index([trainerId])
}

// --------------------------- CRM ---------------------------

model Prospect {
  id                  String         @id @default(cuid())
  organizationId      String
  name                String
  contactName         String?
  type                ProspectType   @default(ENTREPRISE)
  email               String?
  phone               String?
  formationOfInterestId String?
  source              ProspectSource @default(AUTRE)
  stage               ProspectStage  @default(NOUVEAU)
  potentialAmount     Int            @default(0) // centimes
  nextAction          String?
  nextFollowUpDate    DateTime?
  isHot               Boolean        @default(false)
  notes               String?
  ownerId             String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formationOfInterest Formation?        @relation(fields: [formationOfInterestId], references: [id], onDelete: SetNull)
  owner               User?             @relation("ProspectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities          ProspectActivity[]

  @@index([organizationId])
  @@index([stage])
}

model ProspectActivity {
  id         String   @id @default(cuid())
  prospectId String
  type       String   // appel, email, note, stage_change
  content    String?
  createdAt  DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

// --------------------------- APPRENANTS ---------------------------

model Learner {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  company        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  feedbacks    Feedback[]

  @@index([organizationId])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  learnerId      String
  sessionId      String
  status         EnrollmentStatus @default(INSCRIT)
  score          Int?
  satisfactionRating Int?
  satisfactionComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  learner      Learner      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  documents    Document[]

  @@unique([learnerId, sessionId])
  @@index([organizationId])
  @@index([sessionId])
}

model Attendance {
  id           String   @id @default(cuid())
  enrollmentId String
  date         DateTime
  slot         Slot
  present      Boolean  @default(false)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

// --------------------------- DOCUMENTS ---------------------------

model DocumentTemplate {
  id              String       @id @default(cuid())
  organizationId  String?      // null = modèle global par défaut
  type            DocumentType
  name            String
  description     String?
  contentTemplate String       // HTML/MJML avec variables {{...}}
  engine          String       @default("TEXT")
  sourceFileUrl   String?
  sourceFileName  String?
  sourceMimeType  String?
  variables       String[]     @default([])
  isDefault       Boolean      @default(false)
  status          DocumentTemplateStatus @default(ACTIVE)
  version         Int          @default(1)
  variablesDetected Json?
  variableMappings Json?
  createdById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  documents    Document[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

model Document {
  id             String         @id @default(cuid())
  organizationId String
  type           DocumentType
  templateId     String?
  status         DocumentStatus @default(A_GENERER)
  fileUrl        String?
  fileName       String?
  mimeType       String?        @default("application/pdf")
  generatedAt    DateTime?
  sentAt         DateTime?
  templateVersion Int?
  completionStatus DocumentCompletionStatus @default(COMPLETE)
  completionScore Int @default(100)
  missingVariables Json?
  generationContextSnapshot Json?
  manualOverrides Json?
  finalizedAt    DateTime?

  // entités liées (au moins une selon le type)
  formationId  String?
  sessionId    String?
  enrollmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  formation    Formation?        @relation(fields: [formationId], references: [id], onDelete: Cascade)
  session      Session?          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sessionId])
  @@index([completionStatus])
}

